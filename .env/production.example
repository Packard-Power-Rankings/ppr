# DNS name only: do not include https:// or a trailing slash.
DOMAIN=packardpowerrankings.com

MONGO_DB_NAME=ppr
MONGO_USER=ppr
MONGO_MAX_POOL_SIZE=50
# Generate with: openssl rand -hex 32
MONGO_PASS=replace-with-a-random-hex-value

# Generate each secret independently with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-random-hex-value
SETUP_TOKEN=replace-with-a-random-hex-value
SECRET_KEY=replace-with-a-random-hex-value

# Use the same domain as DOMAIN unless another frontend calls the API.
CORS_ORIGINS=https://rankings.example.com
ALLOWED_HOSTS=rankings.example.com
